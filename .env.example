# ============================================
# APP CONFIGURATION
# ============================================
# Application display name
NEXT_PUBLIC_APP_NAME=VitalFlow
# Application URL (localhost:3000 for dev, Vercel domain for production)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============================================
# DATABASE (MongoDB)
# ============================================
# MongoDB connection string
# Format: mongodb+srv://username:password@cluster.mongodb.net/database?appName=...
# Get this from MongoDB Atlas → Connect → Drivers
DATABASE_URL=

# ============================================
# AUTHENTICATION (Clerk)
# ============================================
# Get these from Clerk Dashboard → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# ============================================
# AI & RECOMMENDATIONS APIs
# ============================================
# Google Generative AI key for health recommendations
NEXT_PUBLIC_GOOGLE_API_KEY=

# Groq API key (free LLM service) - optional but used for recommendations
GROQ_API_KEY=

# ============================================
# PAYMENT PROCESSING (Stripe)
# ============================================
# Get these from Stripe Dashboard → Developers → API Keys
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Stripe webhook signing secret (from Stripe Dashboard → Webhooks → Signing Secret)
STRIPE_WEBHOOK_SECRET=

# ============================================
# DOCUMENTATION
# ============================================
# For detailed setup instructions, see:
# - VERCEL_ENV_VARS.md (Production deployment)
# - DEPLOYMENT_TROUBLESHOOTING.md (Error fixes)
# - DEPLOYMENT_CHECKLIST.sh (Pre-deployment checklist)
